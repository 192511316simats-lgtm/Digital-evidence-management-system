# GEMINI_API_KEY: Optional in AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: HTTP server port (AI Studio requires 3000)
PORT=3000

# VERITAS_DATA_DIR: Optional directory for SQLite database, RSA keys, and encrypted vault
VERITAS_DATA_DIR="./data"
